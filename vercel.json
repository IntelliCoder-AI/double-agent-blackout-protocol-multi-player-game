{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {"api/game.ts": {"maxDuration": 30}},
  "rewrites": [
    {"source": "/api/session", "destination": "/api/game?route=session"},
    {"source": "/api/sync", "destination": "/api/game?route=sync"},
    {"source": "/health/ready", "destination": "/api/game?route=health"}
  ],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"same-origin"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
  ]}]
}
